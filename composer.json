{
    "name": "fedale/setting-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for runtime, multi-tenant application settings stored in the database",
    "keywords": [
        "symfony",
        "bundle",
        "settings",
        "configuration",
        "multi-tenant",
        "preferences"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Fedale\\SettingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fedale\\SettingBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "psr/cache": "^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.8 || ^3.0",
        "doctrine/orm": "^2.14 || ^3.0",
        "phpunit/phpunit": "^11.0",
        "symfony/cache": "^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "doctrine/orm": "Necessario quando 'provider: doctrine' (storage di default dei settings)",
        "doctrine/doctrine-bundle": "Necessario quando 'provider: doctrine'",
        "symfony/validator": "Abilita la validazione opt-in dei valori per-key (validation.enabled)",
        "twig/twig": "Abilita la funzione Twig setting() per leggere i settings nei template"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
